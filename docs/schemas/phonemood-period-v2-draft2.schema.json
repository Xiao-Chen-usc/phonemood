{
  "type": "object",
  "properties": {
    "record_type": {
      "const": "phonemood_period_export"
    },
    "schema_version": {
      "const": "2.0-draft.2"
    },
    "calculation_version": {
      "type": "string"
    },
    "analysis_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "export_metadata": {
      "type": "object",
      "properties": {
        "generated_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_app_version": {
          "type": "string"
        },
        "data_origin": {
          "enum": [
            "USER_RECORDS",
            "SYNTHETIC_EXAMPLE"
          ]
        }
      },
      "required": [
        "generated_at_utc",
        "source_revision",
        "source_app_version",
        "data_origin"
      ],
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "properties": {
        "calendar_days": {
          "enum": [
            1,
            7,
            30
          ]
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date_inclusive": {
          "type": "string",
          "format": "date"
        },
        "reporting_zone_id": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "includes_ongoing_day": {
          "type": "boolean"
        }
      },
      "required": [
        "calendar_days",
        "start_date",
        "end_date_inclusive",
        "reporting_zone_id",
        "range",
        "includes_ongoing_day"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "mood_scale": {
          "type": "object",
          "properties": {
            "min": {
              "const": 1
            },
            "max": {
              "const": 10
            },
            "higher_is_better": {
              "const": true
            }
          },
          "required": [
            "min",
            "max",
            "higher_is_better"
          ],
          "additionalProperties": false
        },
        "exposure_window_ms": {
          "const": 1800000
        },
        "exposure_anchor": {
          "const": "ANSWER_TIME"
        },
        "interval_convention": {
          "const": "START_INCLUSIVE_END_EXCLUSIVE"
        },
        "prompt_sampling": {
          "const": "ACTIVE_USE_THRESHOLD"
        },
        "default_prompt_interval_minutes": {
          "const": 30
        },
        "daily_summary_population": {
          "const": "COMPLETE_FINISHED_DAYS"
        },
        "percentile_method": {
          "const": "LINEAR_TYPE_7"
        },
        "current_configuration": {
          "type": "object",
          "properties": {
            "prompt_interval_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "session_reset_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "excluded_packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "prompt_interval_minutes",
            "session_reset_minutes",
            "excluded_packages"
          ],
          "additionalProperties": false
        },
        "configuration_at_period_start": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "prompt_interval_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "session_reset_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "excluded_packages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "prompt_interval_minutes",
                "session_reset_minutes",
                "excluded_packages"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/config_change"
          }
        }
      },
      "required": [
        "mood_scale",
        "exposure_window_ms",
        "exposure_anchor",
        "interval_convention",
        "prompt_sampling",
        "default_prompt_interval_minutes",
        "daily_summary_population",
        "percentile_method",
        "current_configuration",
        "configuration_at_period_start",
        "configuration_changes"
      ],
      "additionalProperties": false
    },
    "data_quality": {
      "type": "object",
      "properties": {
        "complete_finished_days": {
          "type": "integer",
          "minimum": 0
        },
        "days_with_records": {
          "type": "integer",
          "minimum": 0
        },
        "period_answer_count": {
          "type": "integer",
          "minimum": 0
        },
        "delivered_prompt_count": {
          "type": "integer",
          "minimum": 0
        },
        "answered_delivered_prompt_count": {
          "type": "integer",
          "minimum": 0
        },
        "response_rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "response_rate_definition": {
          "type": "string"
        },
        "coverage_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_interval"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "complete_finished_days",
        "days_with_records",
        "period_answer_count",
        "delivered_prompt_count",
        "answered_delivered_prompt_count",
        "response_rate",
        "response_rate_definition",
        "coverage_intervals",
        "warnings"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "recorded_active_ms": {
          "type": "integer",
          "minimum": 0
        },
        "daily_statistics": {
          "type": "object",
          "properties": {
            "n_days": {
              "type": "integer",
              "minimum": 0
            },
            "dates": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date"
              }
            },
            "mean_active_ms": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "median_active_ms": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "p25_active_ms": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "p75_active_ms": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "n_days",
            "dates",
            "mean_active_ms",
            "median_active_ms",
            "p25_active_ms",
            "p75_active_ms"
          ],
          "additionalProperties": false
        },
        "mood": {
          "type": "object",
          "properties": {
            "n_answers": {
              "type": "integer",
              "minimum": 0
            },
            "mean_score": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "n_answers",
            "mean_score"
          ],
          "additionalProperties": false
        },
        "apps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/app_time"
          }
        }
      },
      "required": [
        "recorded_active_ms",
        "daily_statistics",
        "mood",
        "apps"
      ],
      "additionalProperties": false
    },
    "days": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "additionalProperties": false
      }
    },
    "usage_segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "mood_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/range"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "coverage_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_interval"
          }
        },
        "prior_mood_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "inclusion_reason": {
          "type": "string"
        }
      },
      "required": [
        "range",
        "usage_segments",
        "coverage_intervals",
        "prior_mood_observations",
        "inclusion_reason"
      ],
      "additionalProperties": false
    },
    "analysis_matrix": {
      "type": "object",
      "properties": {
        "row_unit": {
          "const": "ONE_ANSWERED_MOOD_OBSERVATION_IN_PERIOD"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      },
      "required": [
        "row_unit",
        "rows"
      ],
      "additionalProperties": false
    },
    "statistical_analysis": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "COMPLETED",
            "PARTIAL",
            "INSUFFICIENT_DATA",
            "NOT_RUN",
            "ERROR"
          ]
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_snapshot": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "prior_max_gap_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "cross_report_date_prior_allowed": {
                  "type": "boolean"
                },
                "maximum_response_latency_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "minimum_window_coverage_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minimum_mood_days": {
                  "const": 0
                },
                "minimum_mood_observations": {
                  "const": 20
                },
                "minimum_transitions": {
                  "const": 0
                },
                "minimum_app_observations": {
                  "const": 20
                },
                "near_zero_mood_points": {
                  "type": "number"
                },
                "top_factors_fdr_threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "extra_rules": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "require_significance_for_display": {
                  "const": false
                },
                "require_fdr_for_display": {
                  "const": false
                }
              },
              "required": [
                "prior_max_gap_ms",
                "cross_report_date_prior_allowed",
                "maximum_response_latency_ms",
                "minimum_window_coverage_fraction",
                "minimum_mood_days",
                "minimum_mood_observations",
                "minimum_transitions",
                "minimum_app_observations",
                "near_zero_mood_points",
                "top_factors_fdr_threshold",
                "extra_rules",
                "require_significance_for_display",
                "require_fdr_for_display"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "sections": {
          "type": "object",
          "properties": {
            "daily_use": {
              "$ref": "#/$defs/section"
            },
            "phone_mood": {
              "$ref": "#/$defs/section"
            },
            "app_mood": {
              "$ref": "#/$defs/section"
            }
          },
          "required": [
            "daily_use",
            "phone_mood",
            "app_mood"
          ],
          "additionalProperties": false
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "top_factor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "engine_version",
        "policy_snapshot",
        "sections",
        "models",
        "findings",
        "top_factor_ids"
      ],
      "additionalProperties": false
    },
    "user_insights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/insight"
      }
    },
    "data_dictionary": {
      "type": "object",
      "properties": {
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "definitions",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "schema_version",
    "calculation_version",
    "analysis_version",
    "export_metadata",
    "period",
    "measurement",
    "data_quality",
    "summary",
    "days",
    "apps",
    "usage_segments",
    "sessions",
    "mood_observations",
    "context",
    "analysis_matrix",
    "statistical_analysis",
    "user_insights",
    "data_dictionary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhoneMood single-file period export draft",
  "$defs": {
    "range": {
      "type": "object",
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end_utc_exclusive": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "start_utc",
        "end_utc_exclusive"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN",
            "NOT_OBSERVED"
          ]
        },
        "verified_ms": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_ms": {
          "type": "integer",
          "minimum": 0
        },
        "not_monitored_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "verified_ms",
        "unknown_ms",
        "not_monitored_ms",
        "reasons"
      ],
      "additionalProperties": false
    },
    "app_time": {
      "type": "object",
      "properties": {
        "app_id": {
          "type": "string"
        },
        "active_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "app_id",
        "active_ms"
      ],
      "additionalProperties": false
    },
    "day": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "is_ongoing": {
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "recorded_active_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "apps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/app_time"
          }
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "answered_mood_count": {
          "type": "integer",
          "minimum": 0
        },
        "mean_mood_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible_for_daily_statistics": {
          "type": "boolean"
        }
      },
      "required": [
        "date",
        "range",
        "is_ongoing",
        "coverage",
        "recorded_active_ms",
        "apps",
        "session_count",
        "answered_mood_count",
        "mean_mood_score",
        "eligible_for_daily_statistics"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "app_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "observed_zone_id": {
          "type": "string"
        },
        "zone_inferred": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "range",
        "app_id",
        "session_id",
        "observed_zone_id",
        "zone_inferred"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ACTIVE",
            "INTERRUPTED",
            "CLOSED"
          ]
        },
        "active_ms_in_period": {
          "type": "integer",
          "minimum": 0
        },
        "active_ms_at_snapshot": {
          "type": "integer",
          "minimum": 0
        },
        "started_before_period": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "start_utc",
        "end_utc",
        "status",
        "active_ms_in_period",
        "active_ms_at_snapshot",
        "started_before_period"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "answered_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "answer_zone_id": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "latency_from_checkpoint_ms": {
          "type": "integer",
          "minimum": 0
        },
        "latency_from_first_delivery_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "answered_at_utc",
        "answer_zone_id",
        "score",
        "latency_from_checkpoint_ms",
        "latency_from_first_delivery_ms"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "PERIOD",
            "CONTEXT_ONLY"
          ]
        },
        "checkpoint_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "notification_at_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlay_first_shown_at_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_active_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "response_state": {
          "enum": [
            "ANSWERED",
            "PENDING",
            "MISSED"
          ]
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/response"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "session_id",
        "scope",
        "checkpoint_at_utc",
        "notification_at_utc",
        "overlay_first_shown_at_utc",
        "checkpoint_active_minutes",
        "response_state",
        "response"
      ],
      "additionalProperties": false
    },
    "model_membership": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "included": {
          "type": "boolean"
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "model_id",
        "included",
        "exclusion_reasons"
      ],
      "additionalProperties": false
    },
    "prior": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "gap_ms": {
          "type": "integer",
          "minimum": 0
        },
        "same_report_date": {
          "type": "boolean"
        },
        "eligible_as_covariate": {
          "type": "boolean"
